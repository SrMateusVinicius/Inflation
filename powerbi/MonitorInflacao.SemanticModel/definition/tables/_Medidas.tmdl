	/// Legenda da rosca (2 colunas, ordenada por peso) com as mesmas cores fixas por grupo.
	measure 'HTML Legenda Pesos' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS (
			            ALL ( dGrupoIPCA ),
			            "@p", [Peso Grupo %],
			            "@cor", SWITCH ( dGrupoIPCA[Grupo], "Alimentação e bebidas", "#8064F5", "Habitação", "#5B45D6", "Transportes", "#B8A6FA", "Saúde e cuidados pessoais", "#3A3946", "Despesas pessoais", "#9D8CF7", "Educação", "#D9D0FD", "Vestuário", "#85838F", "Comunicação", "#C9C7D1", "Artigos de residência", "#6E6C78", "#C9C7D1" ),
			            "@nome", SWITCH ( dGrupoIPCA[Grupo], "Alimentação e bebidas", "Alimentação", "Habitação", "Habitação", "Transportes", "Transportes", "Saúde e cuidados pessoais", "Saúde", "Despesas pessoais", "Desp. pessoais", "Educação", "Educação", "Vestuário", "Vestuário", "Comunicação", "Comunicação", "Artigos de residência", "Art. residência", dGrupoIPCA[Grupo] )
			        ),
			        NOT ISBLANK ( [@p] )
			    )
			RETURN
			    IF ( NOT ISEMPTY ( _T ),
			        "<div style='font-family:Segoe UI,Inter,sans-serif;display:grid;grid-template-columns:1fr 1fr;gap:7px 14px;padding:2px 16px;font-size:11px;color:#25242B;'>"
			        & CONCATENATEX (
			            _T,
			            "<div style='display:flex;align-items:center;gap:6px;min-width:0;' title='" & dGrupoIPCA[Grupo] & "'>"
			                & "<span style='width:9px;height:9px;min-width:9px;border-radius:50%;background:" & [@cor] & ";'></span>"
			                & "<span style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & [@nome] & "</span>"
			                & "<span style='margin-left:auto;color:#85838F;'>" & FORMAT ( [@p], "0.0%" ) & "</span></div>",
			            "",
			            [@p], DESC
			        )
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: bd593d62-8196-54e6-8dad-2d1ab38ac29b

	/// Coluna técnica (vazia) — oculta para a tabela virar 'tabela de medidas'.
	column Medidas
		dataType: string
		isHidden
		lineageTag: 2cb4469c-c0e0-562d-93b2-d05e8558e902
		summarizeBy: none
		sourceColumn: Medidas

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    // Tabela vazia: existe só para hospedar as medidas (coluna oculta)
				    Fonte = #table ( type table [ Medidas = text ], {} )
				in
				    Fonte

	annotation PBI_ResultType = Table

