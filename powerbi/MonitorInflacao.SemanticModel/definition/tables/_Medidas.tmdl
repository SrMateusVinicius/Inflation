			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@c", [Contribuição Grupo (p.p.)] ),
			        NOT ISBLANK ( [@c] )
			    )
			RETURN
			    MINX ( _T, [@c] )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: d4bac30c-9a30-54d8-bf61-f1f66011193a

	/// Variação mensal do grupo de maior contribuição.
	measure 'Variação do Grupo de Maior Pressão %' =
			VAR _Grupo = [Grupo de Maior Pressão]
			RETURN
			    IF ( NOT ISBLANK ( _Grupo ),
			        CALCULATE ( [Variação Grupo Mensal %], REMOVEFILTERS ( dGrupoIPCA ), dGrupoIPCA[Grupo] = _Grupo ) )
		formatString: 0.00%
