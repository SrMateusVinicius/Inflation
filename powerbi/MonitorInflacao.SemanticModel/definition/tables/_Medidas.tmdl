	/// Cor da coluna anual: negativa se estourou o teto.
	measure 'Cor Coluna Realizado vs Teto' =
			-- =============================================================
			-- Cor Coluna Realizado vs Teto
			-- Objetivo : cor da coluna anual: negativa se estourou o teto.
