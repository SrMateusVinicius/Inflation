			    & "<div style='display:flex;align-items:center;gap:10px;'>"
			        & "<div style='width:28px;height:28px;border-radius:9px;background:#8064F5;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;'>%</div>"
			        & "<div style='font-size:21px;font-weight:700;color:#25242B;letter-spacing:-0.3px;'>Expectativas e Juros</div>"
			        & "<div style='font-size:13px;color:#85838F;margin-left:4px;'>Focus · Selic · juro real ex-post</div>"
			    & "</div>"
			    & "<div style='margin-top:5px;white-space:nowrap;overflow:hidden;'>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#8064F5;display:inline-block;'></span>Último período econômico: <b>" & FORMAT ( _UltIPCA, "mmm/yyyy" ) & "</b></span>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#B8A6FA;display:inline-block;'></span>Base atualizada em " & FORMAT ( _Carga, "dd/mm/yyyy hh:nn" ) & "</span>"
			        & "<span style='font-size:11px;color:#85838F;'>Fontes: BCB/SGS · IBGE/SIDRA · Focus · CMN</span>"
			    & "</div>"
			    & "</div>"
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 6daf2c75-a41b-55ad-b157-4eb57c8ad205

	/// Cabeçalho da página Metodologia e Qualidade: título, último período econômico e data da carga (distintos).
	measure 'HTML Cabeçalho Metodologia' =
			VAR _UltIPCA = CALCULATE ( [_Data Referência IPCA], REMOVEFILTERS ( dCalendario ) )
			VAR _Carga   = MAX ( _ControleCarga[DataHoraCarga] )
			VAR _Chip = "<span style='display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#25242B;background:#FFFFFF;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;margin-right:8px;white-space:nowrap;'>"
			RETURN
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;justify-content:center;'>"
			    & "<div style='display:flex;align-items:center;gap:10px;'>"
			        & "<div style='width:28px;height:28px;border-radius:9px;background:#8064F5;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;'>%</div>"
			        & "<div style='font-size:21px;font-weight:700;color:#25242B;letter-spacing:-0.3px;'>Metodologia e Qualidade</div>"
			        & "<div style='font-size:13px;color:#85838F;margin-left:4px;'>Cargas, conferências e regras de cálculo</div>"
			    & "</div>"
			    & "<div style='margin-top:5px;white-space:nowrap;overflow:hidden;'>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#8064F5;display:inline-block;'></span>Último período econômico: <b>" & FORMAT ( _UltIPCA, "mmm/yyyy" ) & "</b></span>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#B8A6FA;display:inline-block;'></span>Base atualizada em " & FORMAT ( _Carga, "dd/mm/yyyy hh:nn" ) & "</span>"
			        & "<span style='font-size:11px;color:#85838F;'>Fontes: BCB/SGS · IBGE/SIDRA · Focus · CMN</span>"
			    & "</div>"
			    & "</div>"
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 86f2a3ef-a73c-520c-88bf-6d294a1ce8d6

	/// Texto central da rosca: IPCA do mês reconstruído pela soma das contribuições.
	measure 'HTML Centro Rosca' =
			VAR _Tot = [Contribuição Total (p.p.)] / 100
			VAR _N   = [Grupos com Dado]
			VAR _Txt = FORMAT ( _Tot * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			RETURN
			    IF ( NOT ISBLANK ( _Tot ),
			        "<div style='font-family:Segoe UI,Inter,sans-serif;text-align:center;line-height:1.15;'>"
			        & "<div style='font-size:11.5px;color:#85838F;'>IPCA do mês</div>"
			        & "<div style='font-size:26px;font-weight:700;color:#25242B;letter-spacing:-0.5px;'>" & _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span></div>"
			        & "<div style='font-size:10.5px;color:#85838F;'>Σ variação × peso</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: a52fa307-94e8-555c-b676-aab9077d6707

	/// Observações calculadas (aceleração, meta, maior pressão, difusão/amplitude) com número e período.
	measure 'HTML Insights' =
			VAR _Nome  = [Indicador Selecionado]
			VAR _Data  = [KPI Data Referência]
			VAR _Mes   = [KPI Mensal %]
			VAR _Ant   = [KPI Mensal Mês Anterior %]
			VAR _DMes  = [KPI Δ Mensal (p.p.)]
			VAR _DataI = [_Data Referência IPCA]
			VAR _IPCA12 = [IPCA 12M %]
			VAR _Meta  = [Meta Ano %]
			VAR _Piso  = [Limite Inferior %]
			VAR _Teto  = [Limite Superior %]
			VAR _DTeto = [Desvio vs Teto (p.p.)]
			VAR _DMeta = [Desvio vs Meta (p.p.)]
			VAR _Cons  = [Meses Consecutivos Acima do Teto]
			VAR _DataG = CALCULATE ( [_Data Referência Grupos], REMOVEFILTERS ( dGrupoIPCA ) )
			VAR _GP    = [Grupo de Maior Pressão]
			VAR _GPc   = [Contribuição do Grupo de Maior Pressão (p.p.)]
			VAR _GPv   = [Variação do Grupo de Maior Pressão %]
			VAR _GPp   = [Peso do Grupo de Maior Pressão %]
			VAR _Tot   = [Contribuição Total (p.p.)]
			VAR _GA    = [Grupo de Maior Alívio]
			VAR _GAc   = [Contribuição do Grupo de Maior Alívio (p.p.)]
			VAR _Alta  = [Grupos em Alta]
			VAR _NG    = [Grupos com Dado]
			VAR _Amp   = [Amplitude entre Grupos (p.p.)]
			VAR _GMax  = [Grupo de Maior Alta]
			VAR _VMax  = [Variação do Grupo de Maior Alta %]
			VAR _GMin  = [Grupo de Maior Queda]
			VAR _VMin  = [Variação do Grupo de Maior Queda %]
			VAR _PP = "+0.00;-0.00;0.00"
			VAR _Tag = "<span style='font-size:10.5px;color:#8064F5;background:#E7E0FF;border-radius:6px;padding:1px 6px;margin-left:6px;white-space:nowrap;'>"
			VAR _Li  = "<div style='display:flex;gap:9px;margin-bottom:6px;'><div style='width:6px;height:6px;min-width:6px;border-radius:50%;background:#8064F5;margin-top:6px;'></div><div>"
			VAR _I1 =
			    IF ( NOT ISBLANK ( _DMes ),
			        _Li & "<b>" & _Nome & "</b> "
			        & SWITCH ( TRUE (), _DMes > 0, "acelerou", _DMes < 0, "desacelerou", "ficou estável" )
			        & " de " & FORMAT ( _Ant, "0.00%" ) & " para <b>" & FORMAT ( _Mes, "0.00%" ) & "</b> ("
			        & FORMAT ( _DMes, _PP ) & " p.p.)" & _Tag & FORMAT ( EDATE ( _Data, -1 ), "mmm/yy" ) & " → " & FORMAT ( _Data, "mmm/yy" ) & "</span></div></div>" )
			VAR _I2 =
			    IF ( NOT ISBLANK ( _IPCA12 ) && NOT ISBLANK ( _Teto ),
			        _Li & "IPCA em 12 meses: <b>" & FORMAT ( _IPCA12, "0.00%" ) & "</b>, "
			        & SWITCH ( TRUE (),
			            _IPCA12 > _Teto, "<b style='color:#D14343;'>" & FORMAT ( _DTeto, "0.00" ) & " p.p. acima do teto</b> de " & FORMAT ( _Teto, "0.00%" )
			                & IF ( _Cons > 1, " há " & _Cons & " meses seguidos", "" ),
			            _IPCA12 < _Piso, "<b style='color:#D14343;'>abaixo do piso</b> de " & FORMAT ( _Piso, "0.00%" ),
			            "<b style='color:#1F8F4E;'>dentro do intervalo</b>, " & FORMAT ( _DMeta, _PP ) & " p.p. vs meta de " & FORMAT ( _Meta, "0.00%" ) )
			        & _Tag & FORMAT ( _DataI, "mmm/yy" ) & "</span></div></div>" )
			VAR _I3 =
			    IF ( NOT ISBLANK ( _GP ),
			        _Li & "<b>" & _GP & "</b> foi a maior pressão: " & FORMAT ( _GPc, _PP ) & " p.p. dos "
			        & FORMAT ( _Tot, "0.00" ) & " p.p. do IPCA (variação " & FORMAT ( _GPv, "0.00%" ) & ", peso " & FORMAT ( _GPp, "0.0%" ) & ")"
			        & IF ( _GAc < 0, "; maior alívio: " & _GA & " (" & FORMAT ( _GAc, _PP ) & " p.p.)", "" )
			        & _Tag & FORMAT ( _DataG, "mmm/yy" ) & "</span></div></div>" )
			VAR _I4 =
			    IF ( _NG > 0,
			        _Li & "<b>" & _Alta & " de " & _NG & "</b> grupos subiram no mês; amplitude de " & FORMAT ( _Amp, "0.00" )
			        & " p.p. entre " & _GMax & " (" & FORMAT ( _VMax, "0.00%" ) & ") e " & _GMin & " (" & FORMAT ( _VMin, "0.00%" ) & ")"
			        & _Tag & FORMAT ( _DataG, "mmm/yy" ) & "</span></div></div>" )
			RETURN
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 18px;color:#25242B;font-size:11.5px;line-height:1.38;'>"
			    & "<div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;'>"
			        & "<div style='font-size:15px;font-weight:600;'>Insights do período</div>"
			        & "<div style='font-size:10.5px;color:#85838F;'>calculados a partir dos dados · sem inferência causal</div>"
			    & "</div>"
			    & _I1 & _I2 & _I3 & _I4
			    & "</div>"
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 8b4f8a1d-50fa-5370-bc4e-30b95ec2a8ab

	/// Mini card: IPCA reconstruído pelos grupos.
	measure 'HTML Mini Contribuição Total' =
			VAR _V = [Contribuição Total (p.p.)] / 100
			VAR _Txt = FORMAT ( _V * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _VH = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>IPCA do mês (Σ grupos)</div>"
			        & "<div style='font-size:24px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Soma de variação × peso · " & FORMAT ( CALCULATE ( [_Data Referência Grupos], REMOVEFILTERS ( dGrupoIPCA ) ), "mmm/yyyy" ) & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 22dff427-6bd2-5cd8-823d-4ad29a0e38fb

	/// Mini card: grupo de maior contribuição ponderada.
	measure 'HTML Mini Maior Pressão' =
			VAR _V = [Grupo de Maior Pressão]
			VAR _VH = _V
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>Maior pressão (contribuição)</div>"
			        & "<div style='font-size:19px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & FORMAT ( [Contribuição do Grupo de Maior Pressão (p.p.)], "+0.00;-0.00" ) & " p.p. · variação " & FORMAT ( [Variação do Grupo de Maior Pressão %], "0.00%" ) & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: f41e2f4d-f2e6-50f5-a75c-1ec28efc23c0

	/// Mini card: grupo de maior variação percentual (≠ maior contribuição).
	measure 'HTML Mini Maior Alta' =
			VAR _V = [Grupo de Maior Alta]
			VAR _VH = _V
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>Maior variação no mês</div>"
			        & "<div style='font-size:19px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & FORMAT ( [Variação do Grupo de Maior Alta %], "0.00%" ) & " · maior queda: " & [Grupo de Maior Queda] & " " & FORMAT ( [Variação do Grupo de Maior Queda %], "0.00%" ) & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 4e578e45-e020-5b63-9fdb-9993eaf38825

	/// Mini card: % de grupos com variação positiva.
	measure 'HTML Mini Difusão' =
			VAR _V = [Difusão de Alta %]
			VAR _Txt = FORMAT ( _V * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _VH = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>Difusão entre grupos</div>"
			        & "<div style='font-size:24px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & [Grupos em Alta] & " de " & [Grupos com Dado] & " grupos em alta · amplitude " & FORMAT ( [Amplitude entre Grupos (p.p.)], "0.00" ) & " p.p." & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: f9700d65-1777-5e43-84f6-c1fb5344dfa4

	/// Mini card IPCA 12M.
	measure 'HTML Mini IPCA 12M' =
			VAR _V = [IPCA 12M %]
			VAR _Txt = FORMAT ( _V * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _VH = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>IPCA · 12 meses</div>"
			        & "<div style='font-size:24px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Acum. ano " & FORMAT ( [IPCA Acum. Ano %], "0.00%" ) & " · " & FORMAT ( [_Data Referência IPCA], "mmm/yyyy" ) & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: b3e137e6-ea2f-58fc-9c12-7f0c1ce23371

	/// Mini card INPC 12M.
	measure 'HTML Mini INPC 12M' =
			VAR _V = [INPC 12M %]
			VAR _Txt = FORMAT ( _V * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _VH = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>INPC · 12 meses</div>"
			        & "<div style='font-size:24px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Acum. ano " & FORMAT ( [INPC Acum. Ano %], "0.00%" ) & " · spread IPCA " & FORMAT ( [Spread IPCA − INPC (p.p.)], "+0.00;-0.00;0.00" ) & " p.p." & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: df507e22-1ffe-5f3f-bc4c-0edc6a0ee064

