	/// Acumulado 12M encerrado no mês anterior.
	measure 'KPI 12M Mês Anterior %' =
			VAR _Data = [KPI Data Referência]
			RETURN
			    IF (
			        NOT ISBLANK ( _Data ),
			        CALCULATE ( [KPI 12M %], REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _Data, -1 ) )
