	/// Mini card: resultado da conferência do 12M.
	measure 'HTML Mini Checagem' =
			VAR _V = IF ( NOT ISBLANK ( [IPCA 12M %] ), [Checagem Meses Divergentes] & " mês(es) divergente(s)" )
			VAR _VH = _V
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:12px 16px;display:flex;flex-direction:column;justify-content:space-between;'>"
			        & "<div style='font-size:12.5px;font-weight:600;color:#85838F;'>Conferência IPCA 12M × SGS 13522</div>"
			        & "<div style='font-size:19px;font-weight:700;color:#25242B;letter-spacing:-0.4px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _VH & "</div>"
			        & "<div style='font-size:11px;color:#85838F;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Tolerância 0,01 p.p. · último mês " & FORMAT ( [Checagem IPCA 12M (p.p.)], "+0.00;-0.00;0.00" ) & " p.p." & "</div>"
			        & "</div>" )
		displayFolder: 09 Dashboard\05 HTML
