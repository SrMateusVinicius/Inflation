	/// IPCA 12M calculado (DAX) menos a série oficial SGS 13522.
	measure 'Checagem IPCA 12M (p.p.)' =
			-- =============================================================
			-- Checagem IPCA 12M (p.p.)
			-- Objetivo : validar a regra de composição do IPCA 12M contra o número oficial.
			-- Regra    : diferença em p.p. com ambos arredondados a 2 casas (como publicados).
			--            Esperado: 0,00 (até ±0,02 por arredondamento das taxas mensais).
			-- =============================================================
			VAR _Calc    = [IPCA 12M %]
			VAR _Oficial = [IPCA 12M % (SGS 13522)]
			RETURN
			    IF (
			        NOT ISBLANK ( _Calc ) && NOT ISBLANK ( _Oficial ),
			        ROUND ( _Calc * 100, 2 ) - ROUND ( _Oficial * 100, 2 )
			    )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 08 Auxiliares
		lineageTag: 11d9e5d7-3bee-5dc6-a62a-92c414658412

	/// OK / Arredondamento / Divergente.
	measure 'Checagem IPCA 12M Status' =
			-- =============================================================
			-- Checagem IPCA 12M Status
			-- Objetivo : OK / Arredondamento / Divergente.
			-- =============================================================
			VAR _Dif = ABS ( [Checagem IPCA 12M (p.p.)] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Dif ), BLANK (),
			        _Dif <= 0.01, "OK",
			        _Dif <= 0.05, "Arredondamento",
			        "Divergente"
			    )
		displayFolder: 08 Auxiliares
		lineageTag: c64b4456-b1ea-55cb-aa06-75c45ac91f99

	/// Meses do período com |diferença| > 0,01 p.p.
	measure 'Checagem Meses Divergentes' =
			-- =============================================================
			-- Checagem Meses Divergentes
			-- Objetivo : meses do período com |diferença| > 0,01 p.p.
			-- =============================================================
			VAR _Tabela =
			    ADDCOLUMNS (
			        VALUES ( dCalendario[Data] ),
			        "@Dif", ABS ( [Checagem IPCA 12M (p.p.)] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _Tabela, [@Dif] > 0.01 ) ) + 0
		formatString: 0
		displayFolder: 08 Auxiliares
		lineageTag: c2029f9f-7c7d-51f0-bf9d-9f7bd9be16b4

	/// IPCA 12M apenas no último mês com dado (série-marcador do gráfico).
	measure 'Marcador Último Ponto IPCA 12M' =
			-- =============================================================
			-- Marcador Último Ponto IPCA 12M
			-- Objetivo : destacar o último ponto da linha IPCA 12M × Meta.
			-- Uso      : 2ª série do gráfico de linhas, só com marcador e rótulo (linha oculta).
			-- =============================================================
			VAR _Mes    = MAX ( dCalendario[Data] )
			VAR _Ultimo = [Último Mês Disponível]
			RETURN
			    IF ( _Mes = _Ultimo, [IPCA 12M %] )
		formatString: 0.00%
		displayFolder: 08 Auxiliares
		lineageTag: 99c054ae-323e-5988-bb5a-1a49a970776c

	/// Rótulo 'Acima do teto em X p.p.' para as colunas dos anos que estouraram.
	measure 'Rótulo Acima do Teto' =
			-- =============================================================
			-- Rótulo Acima do Teto
			-- Objetivo : rótulo 'Acima do teto em X p.p.' para as colunas dos anos que estouraram.
			-- =============================================================
			VAR _Excesso = [Acima do Teto no Ano (p.p.)]
			RETURN
			    IF ( NOT ISBLANK ( _Excesso ), "Acima do teto em " & FORMAT ( _Excesso, "0.00" ) & " p.p." )
		displayFolder: 07 Textos e HTML
		lineageTag: 644477da-f592-58dd-8b3d-3b0f7444505b

	/// Código SGS do indicador ativo no seletor; IPCA (433) quando não há seleção única válida.
	measure '_Sel Código Indicador' =
			-- Indicador escolhido no seletor (somente séries de inflação com taxa mensal).
			-- Sem seleção única (ou seleção inválida) => IPCA (433), o indicador oficial da meta.
			VAR _Cod  = SELECTEDVALUE ( dIndicador[CodigoSGS] )
			VAR _Tipo = SELECTEDVALUE ( dIndicador[TipoTaxa] )
			VAR _Cat  = SELECTEDVALUE ( dIndicador[Categoria] )
			RETURN
			    IF ( NOT ISBLANK ( _Cod ) && _Tipo = "Mensal" && _Cat = "Inflação", _Cod, 433 )
		formatString: 0
		isHidden
		displayFolder: 09 Dashboard\06 Auxiliares
		lineageTag: e7ee271b-60f3-5d1a-81f6-4a746dbdcd2a

	/// Nome do indicador ativo no seletor (IPCA por padrão).
	measure 'Indicador Selecionado' =
			VAR _Cod = [_Sel Código Indicador]
			    RETURN
			        CALCULATE ( MAX ( dIndicador[Indicador] ), REMOVEFILTERS ( dIndicador ), dIndicador[CodigoSGS] = _Cod )
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: 893be77d-bfed-55d3-b2e2-4ec2f9382260

	/// Último mês com dado publicado do indicador ativo, dentro do período filtrado.
	measure 'KPI Data Referência' =
			VAR _Cod = [_Sel Código Indicador]
			    RETURN
			        CALCULATE ( [_Data Referência], REMOVEFILTERS ( dIndicador ), dIndicador[CodigoSGS] = _Cod )
		formatString: mmm/yyyy
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: d04680d6-f660-560a-b1b2-9739dd79d0e4

	/// Taxa do último mês do indicador ativo (BLANK = sem dado, diferente de 0%).
	measure 'KPI Mensal %' =
			VAR _Cod = [_Sel Código Indicador]
			    RETURN
			        CALCULATE ( [Indicador Mensal %], REMOVEFILTERS ( dIndicador ), dIndicador[CodigoSGS] = _Cod )
		formatString: 0.00%
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: 425d888f-52ff-5fa2-9261-4c53cfce1bc1

	/// Acumulado no ano (composição multiplicativa) até o mês de referência do indicador ativo.
	measure 'KPI Acum. Ano %' =
			VAR _Cod = [_Sel Código Indicador]
			    RETURN
			        CALCULATE ( [Indicador Acum. Ano %], REMOVEFILTERS ( dIndicador ), dIndicador[CodigoSGS] = _Cod )
		formatString: 0.00%
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: a4dd260d-de49-5447-a0a2-e8e8234970e5

	/// Acumulado em 12 meses (exige 12 meses publicados) do indicador ativo.
	measure 'KPI 12M %' =
			VAR _Cod = [_Sel Código Indicador]
			    RETURN
			        CALCULATE ( [Indicador 12M %], REMOVEFILTERS ( dIndicador ), dIndicador[CodigoSGS] = _Cod )
		formatString: 0.00%
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: d19a1fc1-7f42-55d1-ae24-77e2ba36eeb0

	/// Taxa mensal média equivalente (geométrica) dos últimos 12 meses.
	measure 'KPI Média Mensal 12M %' =
			-- Média geométrica mensal equivalente à janela de 12 meses: (1 + 12M)^(1/12) - 1
			VAR _12M = [KPI 12M %]
			RETURN
			    IF ( NOT ISBLANK ( _12M ), POWER ( 1 + _12M, 1 / 12 ) - 1 )
		formatString: 0.00%
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: f075f610-09f7-5bf5-a91b-42189339a21b

	/// Meses com dado publicado no ano do mês de referência.
	measure 'KPI Meses Apurados no Ano' =
			VAR _Cod = [_Sel Código Indicador]
			    VAR _Data = [KPI Data Referência]
			    RETURN
			        IF (
			            NOT ISBLANK ( _Data ),
			            CALCULATE (
			                COUNTROWS ( fIndicadores ),
			                REMOVEFILTERS ( dCalendario ),
			                REMOVEFILTERS ( dIndicador ),
			                dIndicador[CodigoSGS] = _Cod,
			                dCalendario[Data] >= DATE ( YEAR ( _Data ), 1, 1 ),
			                dCalendario[Data] <= _Data
			            )
			        )
		formatString: 0
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: 4f245163-0b6a-50e8-ba31-5154dff6b923

	/// Meses do ano com taxa positiva (0 quando todos ≤ 0).
	measure 'KPI Meses em Alta no Ano' =
			VAR _Cod = [_Sel Código Indicador]
			    VAR _Data = [KPI Data Referência]
			    RETURN
			        IF (
			            NOT ISBLANK ( _Data ),
			            CALCULATE (
			                COUNTROWS ( fIndicadores ),
			                REMOVEFILTERS ( dCalendario ),
			                REMOVEFILTERS ( dIndicador ),
			                dIndicador[CodigoSGS] = _Cod,
			                dCalendario[Data] >= DATE ( YEAR ( _Data ), 1, 1 ),
			                dCalendario[Data] <= _Data,
			                fIndicadores[Valor] > 0
			            ) + 0
			        )
		formatString: 0
		displayFolder: 09 Dashboard\01 KPIs
		lineageTag: 39ef579a-6ade-5c3c-97ac-1b52d6c313cd

	/// Taxa do mês anterior ao de referência.
	measure 'KPI Mensal Mês Anterior %' =
			VAR _Data = [KPI Data Referência]
			RETURN
			    IF (
			        NOT ISBLANK ( _Data ),
			        CALCULATE ( [KPI Mensal %], REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _Data, -1 ) )
			    )
