	/// Acumulado da janela de 12 meses imediatamente anterior (encerrada 12 meses antes).
	measure 'KPI 12M Janela Anterior %' =
			VAR _Data = [KPI Data Referência]
			RETURN
			    IF (
			        NOT ISBLANK ( _Data ),
			        CALCULATE ( [KPI 12M %], REMOVEFILTERS ( dCalendario ), dCalendario[Data] = EDATE ( _Data, -12 ) )
			    )
