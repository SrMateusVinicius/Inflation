	/// Peso (IBGE) do grupo de maior contribuição.
	measure 'Peso do Grupo de Maior Pressão %' =
			VAR _Grupo = [Grupo de Maior Pressão]
			RETURN
			    IF ( NOT ISBLANK ( _Grupo ),
			        CALCULATE ( [Peso Grupo %], REMOVEFILTERS ( dGrupoIPCA ), dGrupoIPCA[Grupo] = _Grupo ) )
		formatString: 0.00%
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
