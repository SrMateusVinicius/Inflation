			-- =============================================================
			VAR _Juro = [Juro Real Ex-Post %]
			RETURN
			    IF (
			        NOT ISBLANK ( _Juro ),
			        "O juro real ex-post em 12 meses é de " & FORMAT ( _Juro, "0.00%" )
