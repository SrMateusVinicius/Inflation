	/// Contribuição (p.p.) somente nos últimos 24 meses do período — para o gráfico empilhado.
	measure 'Contribuição Grupo Janela 24M (p.p.)' =
			-- Contribuição por grupo limitada aos 24 meses que terminam no último mês do período filtrado.
			VAR _Mes = MAX ( dCalendario[Data] )
			VAR _Fim = CALCULATE ( [_Data Referência Grupos], ALLSELECTED ( dCalendario ), REMOVEFILTERS ( dGrupoIPCA ) )
			RETURN
			    IF ( _Mes <= _Fim && _Mes > EDATE ( _Fim, -24 ), [Contribuição Grupo (p.p.)] )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 0be82d9f-c485-5103-a165-e68f977811b1

	/// Valor do acumulado 12M só no último mês observado (marcador do gráfico).
	measure 'Gráfico Último Ponto 12M' =
			-- Destaca apenas o último mês com dado dentro do período selecionado.
			VAR _Mes = MAX ( dCalendario[Data] )
			VAR _Ult = CALCULATE ( [KPI Data Referência], ALLSELECTED ( dCalendario ) )
			RETURN
			    IF ( HASONEVALUE ( dCalendario[Data] ) && _Mes = _Ult, [KPI 12M %] )
		formatString: 0.00%
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: bf8b09c4-1d06-5025-80ce-2ded133f0279

	/// Violeta para contribuição positiva, lilás para negativa.
	measure 'Cor Contribuição' =
			VAR _C = [Contribuição Grupo (p.p.)]
			RETURN
			    IF ( _C < 0, "#B8A6FA", "#8064F5" )
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: d424b1e2-2a0a-50ed-b811-ca27a946bfed

	/// Violeta para variação positiva, lilás para negativa.
	measure 'Cor Variação Grupo' =
			VAR _V = [Variação Grupo Mensal %]
			RETURN
			    IF ( _V < 0, "#B8A6FA", "#8064F5" )
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: 909ac875-e6fa-5643-ba2a-53d77718a89d

	/// Título dinâmico do gráfico principal.
	measure 'Título Evolução' = "Evolução da inflação · " & [Indicador Selecionado] & " acumulado em 12 meses"
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: 5075d39e-c409-5b75-a1ec-ac2865a935cf

	/// Título dinâmico do ranking de contribuições.
	measure 'Título Contribuição' =
			VAR _D = CALCULATE ( [_Data Referência Grupos], REMOVEFILTERS ( dGrupoIPCA ) )
			RETURN
			    "Contribuição por grupo · IPCA " & FORMAT ( _D, "mmm/yy" ) & " (p.p.)"
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: 2264f7c6-5f98-59ad-bf85-bcbb4041c3bf

	/// Título dinâmico do ranking de variações.
	measure 'Título Variação Grupos' =
			VAR _D = CALCULATE ( [_Data Referência Grupos], REMOVEFILTERS ( dGrupoIPCA ) )
			RETURN
			    "Variação do mês por grupo · " & FORMAT ( _D, "mmm/yy" )
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: 8e160793-a896-5205-bc45-1de1db28b81b

	/// Título dinâmico da rosca de pesos.
	measure 'Título Rosca Pesos' =
			VAR _D = CALCULATE ( [_Data Referência Grupos], REMOVEFILTERS ( dGrupoIPCA ) )
			RETURN
			    "Peso dos grupos no IPCA · " & FORMAT ( _D, "mmm/yy" )
		displayFolder: 09 Dashboard\04 Gráficos e Títulos
		lineageTag: 19317cd7-36e2-5df2-8174-6bfa11da4568

	/// Card executivo: taxa do último mês, aceleração vs mês anterior e contexto.
	measure 'HTML KPI Mês' =
			VAR _Nome  = [Indicador Selecionado]
			VAR _Data  = [KPI Data Referência]
			VAR _Valor = [KPI Mensal %]
			VAR _Ant   = [KPI Mensal Mês Anterior %]
			VAR _Delta = [KPI Δ Mensal (p.p.)]
			VAR _AA    = [KPI Mensal Mesmo Mês Ano Anterior %]
			VAR _Alta  = [KPI Meses em Alta no Ano]
			VAR _Qtd   = [KPI Meses Apurados no Ano]
			VAR _Txt = FORMAT ( _Valor * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _ValorHtml = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			VAR _BBg = SWITCH ( TRUE (), _Delta > 0, "#FCE6E6", _Delta < 0, "#DDF5E5", "#F0EFF5" )
			VAR _BFg = SWITCH ( TRUE (), _Delta > 0, "#D14343", _Delta < 0, "#1F8F4E", "#85838F" )
			VAR _Seta = SWITCH ( TRUE (), _Delta > 0, "↑", _Delta < 0, "↓", "→" )
			VAR _Badge =
			    IF (
			        NOT ISBLANK ( _Delta ),
			        "<span style='display:inline-block;background:" & _BBg & ";color:" & _BFg
			            & ";padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;'>"
			            & _Seta & " " & FORMAT ( ABS ( _Delta ), "0.00" ) & " p.p.</span>"
			            & "<span style='font-size:11.5px;color:#85838F;margin-left:8px;'>" & "vs " & FORMAT ( EDATE ( _Data, -1 ), "mmm/yy" ) & " (" & FORMAT ( _Ant, "0.00%" ) & ")" & "</span>"
			    )
			VAR _Nota =
			    SWITCH ( TRUE (),
			        ISBLANK ( _Delta ), "Sem mês anterior para comparar",
			        _Delta > 0, "Acelerou frente a " & FORMAT ( _Ant, "0.00%" ) & " no mês anterior",
			        _Delta < 0, "Desacelerou frente a " & FORMAT ( _Ant, "0.00%" ) & " no mês anterior",
			        "Estável frente ao mês anterior" )
			RETURN
			    IF ( ISBLANK ( _Valor ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:14px 18px 12px 18px;display:flex;flex-direction:column;'>"
			    & "<div style='display:flex;justify-content:space-between;align-items:center;gap:8px;'>"
			        & "<div style='font-size:14.5px;font-weight:600;color:#25242B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Inflação do mês · " & _Nome & "</div>"
			        & "<div style='font-size:11px;color:#25242B;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;white-space:nowrap;'>" & FORMAT ( _Data, "mmm/yyyy" ) & "</div>"
			    & "</div>"
			    & "<div style='font-size:32px;font-weight:700;color:#25242B;letter-spacing:-0.6px;margin:6px 0 5px 0;line-height:1.1;'>" & _ValorHtml & "</div>"
			    & "<div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _Badge & "</div>"
			    & "<div style='display:flex;justify-content:space-between;gap:10px;border-top:1px solid #F0EFF5;padding-top:8px;margin-top:auto;'>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>↺</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & IF ( ISBLANK ( _AA ), "–", FORMAT ( _AA, "0.00%" )) & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & FORMAT ( EDATE ( _Data, -12 ), "mmm/yy" ) & "</span></div></div>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>▲</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & _Alta & " de " & _Qtd & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & "meses em alta" & "</span></div></div>" & "</div>"
			    & "</div>"
			    )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 2f6936ef-c852-50a8-b84f-b8c14f8fc11d

	/// Card executivo: acumulado no ano vs mesmo período do ano anterior.
	measure 'HTML KPI Acum. Ano' =
			VAR _Nome  = [Indicador Selecionado]
			VAR _Data  = [KPI Data Referência]
			VAR _Valor = [KPI Acum. Ano %]
			VAR _AA    = [KPI Acum. Ano Mesmo Período Ano Anterior %]
			VAR _Delta = [KPI Δ Acum. Ano (p.p.)]
			VAR _Qtd   = [KPI Meses Apurados no Ano]
			VAR _Media = IF ( _Qtd > 0, POWER ( 1 + _Valor, 1 / _Qtd ) - 1 )
			VAR _Txt = FORMAT ( _Valor * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _ValorHtml = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			VAR _BBg = SWITCH ( TRUE (), _Delta > 0, "#FCE6E6", _Delta < 0, "#DDF5E5", "#F0EFF5" )
			VAR _BFg = SWITCH ( TRUE (), _Delta > 0, "#D14343", _Delta < 0, "#1F8F4E", "#85838F" )
			VAR _Seta = SWITCH ( TRUE (), _Delta > 0, "↑", _Delta < 0, "↓", "→" )
			VAR _Badge =
			    IF (
			        NOT ISBLANK ( _Delta ),
			        "<span style='display:inline-block;background:" & _BBg & ";color:" & _BFg
			            & ";padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;'>"
			            & _Seta & " " & FORMAT ( ABS ( _Delta ), "0.00" ) & " p.p.</span>"
			            & "<span style='font-size:11.5px;color:#85838F;margin-left:8px;'>" & "vs jan–" & FORMAT ( EDATE ( _Data, -12 ), "mmm/yy" ) & " (" & FORMAT ( _AA, "0.00%" ) & ")" & "</span>"
			    )
			VAR _Nota =
			    IF ( ISBLANK ( _AA ), "Sem ano anterior para comparar",
			        "Mesmo período de " & YEAR ( _Data ) - 1 & ": " & FORMAT ( _AA, "0.00%" ) )
			RETURN
			    IF ( ISBLANK ( _Valor ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:14px 18px 12px 18px;display:flex;flex-direction:column;'>"
			    & "<div style='display:flex;justify-content:space-between;align-items:center;gap:8px;'>"
			        & "<div style='font-size:14.5px;font-weight:600;color:#25242B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Acumulado no ano" & "</div>"
			        & "<div style='font-size:11px;color:#25242B;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;white-space:nowrap;'>" & "jan–" & FORMAT ( _Data, "mmm/yyyy" ) & "</div>"
			    & "</div>"
			    & "<div style='font-size:32px;font-weight:700;color:#25242B;letter-spacing:-0.6px;margin:6px 0 5px 0;line-height:1.1;'>" & _ValorHtml & "</div>"
			    & "<div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _Badge & "</div>"
			    & "<div style='display:flex;justify-content:space-between;gap:10px;border-top:1px solid #F0EFF5;padding-top:8px;margin-top:auto;'>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>Σ</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & _Qtd & IF ( _Qtd = 1, " mês", " meses" ) & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & "apurados no ano" & "</span></div></div>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>≈</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & FORMAT ( _Media, "0.00%" ) & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & "média mensal" & "</span></div></div>" & "</div>"
			    & "</div>"
			    )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: a92ac963-c0c3-5ddd-a31f-23ddc6701300

	/// Card executivo: acumulado 12M vs janela de 12 meses anterior.
	measure 'HTML KPI 12M' =
			VAR _Data  = [KPI Data Referência]
			VAR _Valor = [KPI 12M %]
			VAR _Jan   = [KPI 12M Janela Anterior %]
			VAR _Delta = [KPI Δ 12M vs Janela Anterior (p.p.)]
			VAR _MesAnt = [KPI 12M Mês Anterior %]
			VAR _DMes  = [KPI Δ 12M vs Mês Anterior (p.p.)]
			VAR _Media = [KPI Média Mensal 12M %]
			VAR _Txt = FORMAT ( _Valor * 100, "0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _ValorHtml = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "%</span>"
			VAR _BBg = SWITCH ( TRUE (), _Delta > 0, "#FCE6E6", _Delta < 0, "#DDF5E5", "#F0EFF5" )
			VAR _BFg = SWITCH ( TRUE (), _Delta > 0, "#D14343", _Delta < 0, "#1F8F4E", "#85838F" )
			VAR _Seta = SWITCH ( TRUE (), _Delta > 0, "↑", _Delta < 0, "↓", "→" )
			VAR _Badge =
			    IF (
			        NOT ISBLANK ( _Delta ),
			        "<span style='display:inline-block;background:" & _BBg & ";color:" & _BFg
			            & ";padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;'>"
			            & _Seta & " " & FORMAT ( ABS ( _Delta ), "0.00" ) & " p.p.</span>"
			            & "<span style='font-size:11.5px;color:#85838F;margin-left:8px;'>" & "vs 12M anteriores (" & FORMAT ( _Jan, "0.00%" ) & ")" & "</span>"
			    )
			VAR _Nota =
			    IF ( ISBLANK ( _Jan ), "Sem janela anterior completa",
			        FORMAT ( EDATE ( _Data, -23 ), "mmm/yy" ) & "–" & FORMAT ( EDATE ( _Data, -12 ), "mmm/yy" ) & ": " & FORMAT ( _Jan, "0.00%" ) )
			RETURN
			    IF ( ISBLANK ( _Valor ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:14px 18px 12px 18px;display:flex;flex-direction:column;'>"
			    & "<div style='display:flex;justify-content:space-between;align-items:center;gap:8px;'>"
			        & "<div style='font-size:14.5px;font-weight:600;color:#25242B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "Acumulado 12 meses" & "</div>"
			        & "<div style='font-size:11px;color:#25242B;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;white-space:nowrap;'>" & FORMAT ( EDATE ( _Data, -11 ), "mmm/yy" ) & "–" & FORMAT ( _Data, "mmm/yy" ) & "</div>"
			    & "</div>"
			    & "<div style='font-size:32px;font-weight:700;color:#25242B;letter-spacing:-0.6px;margin:6px 0 5px 0;line-height:1.1;'>" & _ValorHtml & "</div>"
			    & "<div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _Badge & "</div>"
			    & "<div style='display:flex;justify-content:space-between;gap:10px;border-top:1px solid #F0EFF5;padding-top:8px;margin-top:auto;'>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>⇅</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & IF ( ISBLANK ( _DMes ), "–", FORMAT ( _DMes, "+0.00;-0.00;0.00" ) & " p.p." ) & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & "vs mês anterior" & "</span></div></div>" & "<div style='display:flex;align-items:center;gap:7px;min-width:0;'><div style='width:24px;height:24px;min-width:24px;border-radius:50%;background:#E7E0FF;color:#8064F5;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;'>≈</div><div style='font-size:11.5px;line-height:1.2;color:#25242B;font-weight:600;white-space:nowrap;'>" & FORMAT ( _Media, "0.00%" ) & "<br><span style='font-size:10.5px;color:#85838F;font-weight:400;'>" & "média mensal" & "</span></div></div>" & "</div>"
			    & "</div>"
			    )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: cc0b188b-61c4-521b-98a0-346d0747a7e2

	/// Card executivo: IPCA 12M vs meta do CMN (desvio em p.p., status e régua piso–meta–teto).
	measure 'HTML KPI Meta' =
			VAR _Data   = [_Data Referência IPCA]
			VAR _IPCA   = [IPCA 12M %]
			VAR _Meta   = [Meta Ano %]
			VAR _Piso   = [Limite Inferior %]
			VAR _Teto   = [Limite Superior %]
			VAR _DMeta  = [Desvio vs Meta (p.p.)]
			VAR _DTeto  = [Desvio vs Teto (p.p.)]
			VAR _Status = [Status Meta]
			VAR _Cons   = [Meses Consecutivos Acima do Teto]
			VAR _Tipo   = CALCULATE ( MAX ( dMeta[TipoMeta] ), dMeta[Ano] = YEAR ( _Data ) )
			VAR _Txt = FORMAT ( _DMeta, "+0.00;-0.00;0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _ValorHtml = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "</span><span style='font-size:15px;color:#85838F;font-weight:600;'> p.p.</span>"
			VAR _SBg = SWITCH ( _Status, "Acima do teto", "#FCE6E6", "Abaixo do piso", "#FCE6E6", "#DDF5E5" )
			VAR _SFg = SWITCH ( _Status, "Acima do teto", "#D14343", "Abaixo do piso", "#D14343", "#1F8F4E" )
			VAR _STxt =
			    SWITCH ( _Status,
			        "Acima do teto", "↑ " & FORMAT ( _DTeto, "0.00" ) & " p.p. acima do teto",
			        "Abaixo do piso", "↓ abaixo do piso",
			        "Dentro do intervalo" )
			VAR _Suf =
			    IF ( _Status = "Acima do teto",
			        "há " & _Cons & IF ( _Cons = 1, " mês", " meses" ),
			        "piso–teto " & FORMAT ( _Piso, "0.0%" ) & "–" & FORMAT ( _Teto, "0.0%" ) )
			VAR _Badge =
			    "<span style='display:inline-block;background:" & _SBg & ";color:" & _SFg & ";padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;'>" & _STxt & "</span>"
			    & "<span style='font-size:11.5px;color:#85838F;margin-left:8px;'>" & _Suf & "</span>"
			-- régua 0% → teto + 2 p.p.: faixa lilás = intervalo de tolerância; traço = meta; ponto = IPCA 12M
			VAR _Max   = _Teto + 0.02
			VAR _PosP  = DIVIDE ( _Piso, _Max ) * 100
			VAR _PosT  = DIVIDE ( _Teto, _Max ) * 100
			VAR _PosM  = DIVIDE ( _Meta, _Max ) * 100
			VAR _PosI  = MIN ( MAX ( DIVIDE ( _IPCA, _Max ) * 100, 0 ), 100 )
			VAR _Regua =
			    "<div style='position:relative;height:8px;border-radius:4px;background:#F0EFF5;margin:12px 0 2px 0;'>"
			    & "<div style='position:absolute;left:" & FORMAT ( _PosP, "0.0", "en-US" ) & "%;width:" & FORMAT ( _PosT - _PosP, "0.0", "en-US" ) & "%;top:0;bottom:0;background:#E7E0FF;border-radius:4px;'></div>"
			    & "<div style='position:absolute;left:" & FORMAT ( _PosM, "0.0", "en-US" ) & "%;top:-2px;width:2px;height:12px;background:#B8A6FA;'></div>"
			    & "<div style='position:absolute;left:calc(" & FORMAT ( _PosI, "0.0", "en-US" ) & "% - 7px);top:-3px;width:14px;height:14px;border-radius:50%;background:#8064F5;border:2px solid #FFFFFF;box-sizing:border-box;'></div>"
			    & "</div>"
			VAR _Nota =
			    "IPCA 12M <b style='color:#25242B;'>" & FORMAT ( _IPCA, "0.00%" ) & "</b> · meta " & FORMAT ( _Meta, "0.00%" ) & " (" & LOWER ( _Tipo ) & ")"
			RETURN
			    IF ( ISBLANK ( _IPCA ) || ISBLANK ( _Meta ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
			        "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;padding:14px 18px 12px 18px;display:flex;flex-direction:column;'>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;'>"
			            & "<div style='font-size:14.5px;font-weight:600;color:#25242B;white-space:nowrap;'>Distância da meta</div>"
			            & "<div style='font-size:11px;color:#25242B;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;white-space:nowrap;'>CMN " & YEAR ( _Data ) & "</div>"
			        & "</div>"
			        & "<div style='font-size:32px;font-weight:700;color:#25242B;letter-spacing:-0.6px;margin:6px 0 5px 0;line-height:1.1;'>" & _ValorHtml & "</div>"
			        & "<div>" & _Badge & "</div>"
			        & _Regua
			        & "<div style='font-size:11.5px;color:#85838F;margin-top:auto;padding-top:6px;border-top:1px solid #F0EFF5;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & _Nota & "</div>"
			        & "</div>"
			    )
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: c7be261f-5f28-5dab-a94f-fc647c471e7c

	/// Cabeçalho da página Monitor de Inflação: título, último período econômico e data da carga (distintos).
	measure 'HTML Cabeçalho Visão Geral' =
			VAR _UltIPCA = CALCULATE ( [_Data Referência IPCA], REMOVEFILTERS ( dCalendario ) )
			VAR _Carga   = MAX ( _ControleCarga[DataHoraCarga] )
			VAR _Chip = "<span style='display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#25242B;background:#FFFFFF;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;margin-right:8px;white-space:nowrap;'>"
			RETURN
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;justify-content:center;'>"
			    & "<div style='display:flex;align-items:center;gap:10px;'>"
			        & "<div style='width:28px;height:28px;border-radius:9px;background:#8064F5;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;'>%</div>"
			        & "<div style='font-size:21px;font-weight:700;color:#25242B;letter-spacing:-0.3px;'>Monitor de Inflação</div>"
			        & "<div style='font-size:13px;color:#85838F;margin-left:4px;'>Brasil · séries mensais oficiais</div>"
			    & "</div>"
			    & "<div style='margin-top:5px;white-space:nowrap;overflow:hidden;'>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#8064F5;display:inline-block;'></span>Último período econômico: <b>" & FORMAT ( _UltIPCA, "mmm/yyyy" ) & "</b></span>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#B8A6FA;display:inline-block;'></span>Base atualizada em " & FORMAT ( _Carga, "dd/mm/yyyy hh:nn" ) & "</span>"
			        & "<span style='font-size:11px;color:#85838F;'>Fontes: BCB/SGS · IBGE/SIDRA · Focus · CMN</span>"
			    & "</div>"
			    & "</div>"
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: 06a11941-d664-5b42-8f34-0028e2ddbc6d

	/// Cabeçalho da página Composição do IPCA: título, último período econômico e data da carga (distintos).
	measure 'HTML Cabeçalho Composição' =
			VAR _UltIPCA = CALCULATE ( [_Data Referência IPCA], REMOVEFILTERS ( dCalendario ) )
			VAR _Carga   = MAX ( _ControleCarga[DataHoraCarga] )
			VAR _Chip = "<span style='display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#25242B;background:#FFFFFF;border:1px solid #E8E8EF;border-radius:14px;padding:3px 10px;margin-right:8px;white-space:nowrap;'>"
			RETURN
			    "<div style='font-family:Segoe UI,Inter,sans-serif;height:100%;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;justify-content:center;'>"
			    & "<div style='display:flex;align-items:center;gap:10px;'>"
			        & "<div style='width:28px;height:28px;border-radius:9px;background:#8064F5;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;'>%</div>"
			        & "<div style='font-size:21px;font-weight:700;color:#25242B;letter-spacing:-0.3px;'>Composição do IPCA</div>"
			        & "<div style='font-size:13px;color:#85838F;margin-left:4px;'>9 grupos · variação, peso e contribuição</div>"
			    & "</div>"
			    & "<div style='margin-top:5px;white-space:nowrap;overflow:hidden;'>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#8064F5;display:inline-block;'></span>Último período econômico: <b>" & FORMAT ( _UltIPCA, "mmm/yyyy" ) & "</b></span>"
			        & _Chip & "<span style='width:7px;height:7px;border-radius:50%;background:#B8A6FA;display:inline-block;'></span>Base atualizada em " & FORMAT ( _Carga, "dd/mm/yyyy hh:nn" ) & "</span>"
			        & "<span style='font-size:11px;color:#85838F;'>Fontes: BCB/SGS · IBGE/SIDRA · Focus · CMN</span>"
			    & "</div>"
			    & "</div>"
		displayFolder: 09 Dashboard\05 HTML
		lineageTag: d75c62bf-bab6-5f93-885c-c1507631d4c8

	/// Cabeçalho da página Comparativos: título, último período econômico e data da carga (distintos).
	measure 'HTML Cabeçalho Comparativos' =
