	/// IGP-M acumulado no ano (composto).
	measure 'IGP-M Acum. Ano %' =
			-- =============================================================
			-- IGP-M Acum. Ano %
			-- Objetivo : IGP-M acumulado no ano (composto).
			-- Regra    : aplica [Indicador Acum. Ano %] fixando a série SGS 189 (IGP-M).
