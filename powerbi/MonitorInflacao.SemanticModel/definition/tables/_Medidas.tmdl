	/// Mini card: diferença livres × monitorados em 12M.
	measure 'HTML Mini Livres x Monitorados' =
			VAR _V = ( [IPCA Livres 12M %] - [IPCA Monitorados 12M %] ) * 100
			VAR _Txt = FORMAT ( _V, "+0.00;-0.00;0.00" )
			VAR _Int = LEFT ( _Txt, LEN ( _Txt ) - 3 )
			VAR _Dec = RIGHT ( _Txt, 3 )
			VAR _VH = _Int & "<span style='color:#C9C7D1;'>" & _Dec & "</span><span style='font-size:13px;color:#85838F;'> p.p.</span>"
			RETURN
			    IF ( ISBLANK ( _V ), "<div style='font-family:Segoe UI,Inter,sans-serif;color:#85838F;padding:18px;font-size:13px;'>Sem dados publicados para o período selecionado.</div>",
