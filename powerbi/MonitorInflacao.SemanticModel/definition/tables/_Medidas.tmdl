	/// Aceleração (+) ou desaceleração (−) da taxa mensal vs mês anterior.
	measure 'KPI Δ Mensal (p.p.)' =
			-- Diferença em pontos percentuais (não é variação relativa).
			VAR _A = [KPI Mensal %]
			VAR _B = [KPI Mensal Mês Anterior %]
			RETURN
			    IF ( NOT ISBLANK ( _A ) && NOT ISBLANK ( _B ), ( _A - _B ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\02 Comparações
		lineageTag: 33c6f620-fb13-5683-b886-6694a9837b56

	/// Acumulado no ano menos o mesmo período do ano anterior.
	measure 'KPI Δ Acum. Ano (p.p.)' =
			-- Diferença em pontos percentuais (não é variação relativa).
			VAR _A = [KPI Acum. Ano %]
			VAR _B = [KPI Acum. Ano Mesmo Período Ano Anterior %]
			RETURN
			    IF ( NOT ISBLANK ( _A ) && NOT ISBLANK ( _B ), ( _A - _B ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\02 Comparações
		lineageTag: 478f9625-28e6-570c-a4ef-a5c19903f0ea

	/// Acumulado 12M menos a janela de 12 meses anterior.
	measure 'KPI Δ 12M vs Janela Anterior (p.p.)' =
			-- Diferença em pontos percentuais (não é variação relativa).
			VAR _A = [KPI 12M %]
			VAR _B = [KPI 12M Janela Anterior %]
			RETURN
			    IF ( NOT ISBLANK ( _A ) && NOT ISBLANK ( _B ), ( _A - _B ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\02 Comparações
		lineageTag: c150ea49-8f41-582e-8267-651946ca23f5

	/// Variação do acumulado 12M em relação ao mês anterior.
	measure 'KPI Δ 12M vs Mês Anterior (p.p.)' =
			-- Diferença em pontos percentuais (não é variação relativa).
			VAR _A = [KPI 12M %]
			VAR _B = [KPI 12M Mês Anterior %]
			RETURN
			    IF ( NOT ISBLANK ( _A ) && NOT ISBLANK ( _B ), ( _A - _B ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\02 Comparações
		lineageTag: 7cd87560-6161-5a33-8a61-9a10b84cde12

	/// Posição do IPCA 12M dentro do intervalo de tolerância da meta (0% = piso, 100% = teto).
	measure 'Posição na Banda da Meta %' =
			-- 0% = piso, 100% = teto. Pode passar de 0–100% (fora do intervalo).
			VAR _IPCA = [IPCA 12M %]
			VAR _Piso = [Limite Inferior %]
			VAR _Teto = [Limite Superior %]
			RETURN
			    IF ( NOT ISBLANK ( _IPCA ) && _Teto > _Piso, DIVIDE ( _IPCA - _Piso, _Teto - _Piso ) )
		formatString: 0%
		displayFolder: 09 Dashboard\02 Comparações
		lineageTag: 892c3b91-fdcb-5807-9aa2-13c3fa542b27

	/// Grupo com a maior VARIAÇÃO percentual no mês (não confundir com maior contribuição).
	measure 'Grupo de Maior Alta' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _Top = TOPN ( 1, _T, [@v], DESC, dGrupoIPCA[Ordem], ASC )
			RETURN
			    MAXX ( _Top, dGrupoIPCA[Grupo] )
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 37a3c0f4-00cb-5260-88d3-01ef218c5c6c

	/// Maior variação mensal entre os grupos.
	measure 'Variação do Grupo de Maior Alta %' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			RETURN
			    MAXX ( _T, [@v] )
		formatString: 0.00%
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 166a375f-aca0-5344-b19d-9d9eb76c7874

	/// Grupo com a menor variação percentual no mês (maior queda, se negativa).
	measure 'Grupo de Maior Queda' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _Top = TOPN ( 1, _T, [@v], ASC, dGrupoIPCA[Ordem], ASC )
			RETURN
			    MAXX ( _Top, dGrupoIPCA[Grupo] )
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: d2e8fb21-6b19-5710-a5c7-859d49ce5f89

	/// Menor variação mensal entre os grupos.
	measure 'Variação do Grupo de Maior Queda %' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			RETURN
			    MINX ( _T, [@v] )
		formatString: 0.00%
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 1f027597-abd6-52f5-a40d-3d8d65b14c77

	/// Amplitude (máx − mín) das variações mensais dos grupos, em p.p.
	measure 'Amplitude entre Grupos (p.p.)' =
			-- Dispersão simples: maior menos menor variação mensal entre os grupos.
			VAR _Max = [Variação do Grupo de Maior Alta %]
			VAR _Min = [Variação do Grupo de Maior Queda %]
			RETURN
			    IF ( NOT ISBLANK ( _Max ) && NOT ISBLANK ( _Min ), ( _Max - _Min ) * 100 )
		formatString: +0.00" p.p.";-0.00" p.p.";0.00" p.p."
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 2de696f9-b0dc-50a1-9f6e-14f37f227dbb

	/// Quantidade de grupos com variação positiva no mês.
	measure 'Grupos em Alta' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _T, [@v] > 0 ) ) + 0
		formatString: 0
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: a0d86e06-e233-5bf9-8993-db48562485cf

	/// Quantidade de grupos com variação publicada no mês.
	measure 'Grupos com Dado' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@v", [Variação Grupo Mensal %] ),
			        NOT ISBLANK ( [@v] )
			    )
			RETURN
			    COUNTROWS ( _T ) + 0
		formatString: 0
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
		lineageTag: 74f57466-d0e8-5e12-9915-7747a696c0af

	/// Grupo com a menor contribuição ponderada (variação × peso) no mês.
	measure 'Grupo de Maior Alívio' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( ALL ( dGrupoIPCA ), "@c", [Contribuição Grupo (p.p.)] ),
			        NOT ISBLANK ( [@c] )
			    )
			VAR _Top = TOPN ( 1, _T, [@c], ASC, dGrupoIPCA[Ordem], ASC )
			RETURN
			    MAXX ( _Top, dGrupoIPCA[Grupo] )
		displayFolder: 09 Dashboard\03 Rankings e Contribuições
