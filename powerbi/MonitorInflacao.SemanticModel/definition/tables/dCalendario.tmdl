/// Dimensão de datas MENSAL gerada no Power Query (1 linha por mês, do 1º ao último mês presente nos fatos). Marcada como tabela de datas.
table dCalendario
	lineageTag: 36ab45d0-e546-5bcb-bae5-863fff18600b
	dataCategory: Time

	/// Primeiro dia do mês (chave de data da tabela de datas).
	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 3977c27b-7a10-5f17-b64c-7b27f9d41a31
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Chave inteira aaaammdd (relacionamento com os fatos).
	column DataKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 37578a00-9b15-5c91-9370-a9e2f1b1361a
		summarizeBy: none
		sourceColumn: DataKey

		annotation SummarizationSetBy = User

	/// Ano civil.
	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 368354d3-29ca-5657-a8cd-43b547777ce0
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = User

	/// Número do mês (1–12); ordena MesAbrev.
	column MesNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6961f1da-eedd-5d73-843b-a21f1d1e7c8e
		summarizeBy: none
		sourceColumn: MesNum

		annotation SummarizationSetBy = User

	/// Mês abreviado pt-BR (jan, fev, ...).
	column MesAbrev
		dataType: string
		lineageTag: 94276716-bc2c-5d59-911f-b8ce624a1791
		summarizeBy: none
		sourceColumn: MesAbrev
		sortByColumn: MesNum

		annotation SummarizationSetBy = User

	/// Rótulo de eixo no formato 'jan/25'.
	column AnoMes
		dataType: string
		lineageTag: e68cf81c-b388-5576-b118-181c5a537ae5
		summarizeBy: none
		sourceColumn: AnoMes
		sortByColumn: AnoMesOrdem

		annotation SummarizationSetBy = User

	/// aaaamm numérico; ordena AnoMes.
	column AnoMesOrdem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b67bcf25-e282-5ea7-ac2a-32f8ec0bc088
		summarizeBy: none
		sourceColumn: AnoMesOrdem

		annotation SummarizationSetBy = User

	/// Trimestre (T1–T4).
	column Trimestre
		dataType: string
		lineageTag: 3b954db5-672b-58a1-8918-4d8ece811667
		summarizeBy: none
		sourceColumn: Trimestre
		sortByColumn: TrimestreNum

		annotation SummarizationSetBy = User

	/// Número do trimestre; ordena Trimestre.
	column TrimestreNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 57616615-70e4-5101-af30-58e69d288dcb
		summarizeBy: none
		sourceColumn: TrimestreNum

		annotation SummarizationSetBy = User

	/// Semestre (S1/S2).
	column Semestre
		dataType: string
		lineageTag: 3cba25ac-6514-526e-b924-8e133b70ee51
		summarizeBy: none
		sourceColumn: Semestre
		sortByColumn: SemestreNum

		annotation SummarizationSetBy = User

	/// Número do semestre; ordena Semestre.
	column SemestreNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6c8fcf8c-1727-56f8-ba83-41952d23fd01
		summarizeBy: none
		sourceColumn: SemestreNum

		annotation SummarizationSetBy = User

	/// Contador de meses desde o início do calendário (1, 2, 3...).
	column MesSequencial
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ebf1ee0b-98c4-5696-a7fd-941df4ae8216
		summarizeBy: none
		sourceColumn: MesSequencial

		annotation SummarizationSetBy = User

	/// TRUE no último mês com IPCA (SGS 433) publicado.
	column EhUltimoMesDisponivel
		dataType: boolean
		lineageTag: 15634a17-22af-5026-9eb4-f01aff1985a6
		summarizeBy: none
		sourceColumn: EhUltimoMesDisponivel

		annotation SummarizationSetBy = User

	/// TRUE nos meses do ano do último IPCA publicado.
	column EhAnoCorrente
		dataType: boolean
		lineageTag: 83b5fa0f-54d8-57ef-a360-f56e5962b2d8
		summarizeBy: none
		sourceColumn: EhAnoCorrente

		annotation SummarizationSetBy = User

	partition dCalendario = m
		mode: import
		source =
				let
				    // ---------------------------------------------------------------
				    // dCalendario MENSAL gerada no Power Query (não em DAX).
				    // Intervalo: do menor ao maior mês presente nos três fatos.
				    // ---------------------------------------------------------------
				    Ind = Parquet.Document ( Binary.Buffer ( Web.Contents ( "https://raw.githubusercontent.com", [ RelativePath = pRepositorio & "/dados/silver/fIndicadores.parquet" ] ) ) ),
				    Grp = Parquet.Document ( Binary.Buffer ( Web.Contents ( "https://raw.githubusercontent.com", [ RelativePath = pRepositorio & "/dados/silver/fIPCAGrupos.parquet" ] ) ) ),
				    Exp = Parquet.Document ( Binary.Buffer ( Web.Contents ( "https://raw.githubusercontent.com", [ RelativePath = pRepositorio & "/dados/silver/fExpectativas.parquet" ] ) ) ),
				    KeyParaData = ( k as number ) as date =>
				        #date ( Number.IntegerDivide ( k, 10000 ), Number.Mod ( Number.IntegerDivide ( k, 100 ), 100 ), 1 ),
				    Chaves = List.Combine ( { Ind[DataKey], Grp[DataKey], Exp[DataColetaKey] } ),
				    Inicio = KeyParaData ( List.Min ( Chaves ) ),
				    Fim = KeyParaData ( List.Max ( Chaves ) ),
				    UltimoIPCA = KeyParaData ( List.Max ( Table.SelectRows ( Ind, each [CodigoSGS] = 433 )[DataKey] ) ),
				    QtdMeses = ( Date.Year ( Fim ) - Date.Year ( Inicio ) ) * 12 + Date.Month ( Fim ) - Date.Month ( Inicio ) + 1,
				    Datas = List.Transform ( { 0 .. QtdMeses - 1 }, each Date.AddMonths ( Inicio, _ ) ),
				    // nomes fixos em pt-BR (independe do idioma do Windows)
				    Meses = { "jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez" },
				    Linhas = List.Transform (
				        Datas,
				        ( d ) => [
				            Data = d,
				            DataKey = Date.Year ( d ) * 10000 + Date.Month ( d ) * 100 + 1,
				            Ano = Date.Year ( d ),
				            MesNum = Date.Month ( d ),
				            MesAbrev = Meses{ Date.Month ( d ) - 1 },
				            AnoMes = Meses{ Date.Month ( d ) - 1 } & "/" & Text.End ( Text.From ( Date.Year ( d ) ), 2 ),
				            AnoMesOrdem = Date.Year ( d ) * 100 + Date.Month ( d ),
				            Trimestre = "T" & Text.From ( Date.QuarterOfYear ( d ) ),
				            TrimestreNum = Date.QuarterOfYear ( d ),
				            Semestre = if Date.Month ( d ) <= 6 then "S1" else "S2",
				            SemestreNum = if Date.Month ( d ) <= 6 then 1 else 2,
				            MesSequencial = ( Date.Year ( d ) - Date.Year ( Inicio ) ) * 12 + Date.Month ( d ) - Date.Month ( Inicio ) + 1,
				            EhUltimoMesDisponivel = d = UltimoIPCA,
				            EhAnoCorrente = Date.Year ( d ) = Date.Year ( UltimoIPCA )
				        ]
				    ),
				    Tabela = Table.FromRecords (
				        Linhas,
				        type table [
				            Data = date, DataKey = Int64.Type, Ano = Int64.Type, MesNum = Int64.Type, MesAbrev = text,
				            AnoMes = text, AnoMesOrdem = Int64.Type, Trimestre = text, TrimestreNum = Int64.Type,
				            Semestre = text, SemestreNum = Int64.Type, MesSequencial = Int64.Type,
				            EhUltimoMesDisponivel = logical, EhAnoCorrente = logical
				        ]
				    )
				in
				    Tabela

	annotation PBI_ResultType = Table

