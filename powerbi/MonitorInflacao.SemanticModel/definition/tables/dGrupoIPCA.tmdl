/// Dimensão dos 9 grupos do IPCA (classificação c315 do SIDRA), com cor fixa para os visuais.
table dGrupoIPCA
	lineageTag: 735f13b2-adec-5a24-a3c7-6b97a84c3605

	/// Código c315 do grupo no SIDRA (chave).
	column CodigoGrupo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9566c019-f79c-534d-8cd6-b37e1f3e4ecc
		summarizeBy: none
		sourceColumn: CodigoGrupo

		annotation SummarizationSetBy = User

	/// Nome do grupo do IPCA.
	column Grupo
		dataType: string
		lineageTag: 9800bd3f-faf7-560c-80a3-b25c1fdf1d0d
		summarizeBy: none
		sourceColumn: Grupo
		sortByColumn: Ordem

		annotation SummarizationSetBy = User

	/// Ordem oficial do IBGE.
	column Ordem
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 86f1642c-5094-5f50-9184-197014e14126
		summarizeBy: none
		sourceColumn: Ordem

		annotation SummarizationSetBy = User

	/// Cor do grupo em hexadecimal (formatação condicional).
	column CorHex
		dataType: string
		isHidden
		lineageTag: 0d221a70-4351-56e3-80f9-c3411e06d257
		summarizeBy: none
		sourceColumn: CorHex

		annotation SummarizationSetBy = User

	partition dGrupoIPCA = m
		mode: import
		source =
				let
				    // Leitura do Parquet tipado da camada silver (GitHub raw; URL base fixa + RelativePath, refresh no Service sem gateway)
				    Fonte = Parquet.Document ( Binary.Buffer ( Web.Contents ( "https://raw.githubusercontent.com", [ RelativePath = pRepositorio & "/dados/silver/dGrupoIPCA.parquet" ] ) ) ),
				    // Mantém só as colunas do modelo (protege contra colunas novas no arquivo)
				    Colunas = Table.SelectColumns ( Fonte, { "CodigoGrupo", "Grupo", "Ordem", "CorHex" } ),
				    // Reafirma os tipos (nenhuma coluna 'any')
				    Tipos = Table.TransformColumnTypes (
				        Colunas,
				        {
				            { "CodigoGrupo", Int64.Type },
				            { "Grupo", type text },
				            { "Ordem", Int64.Type },
				            { "CorHex", type text }
				        }
				    )
				in
				    Tipos

	annotation PBI_ResultType = Table

